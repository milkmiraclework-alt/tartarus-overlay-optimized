{
  "name": "tartarus-overlay-optimized",
  "productName": "Tartarus Optimized",
  "version": "0.2.20-local.27",
  "description": "Auto Screenshot Mode for the Tartarus board analyzer, with the advice in an overlay over the game.",
  "author": "CoffeeBns",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "local": "electron . --fast --site=http://localhost:8090/",
    "dist": "node ../tools/stage-overlay.js && electron-builder --win --x64 --publish never",
    "dist:dir": "node ../tools/stage-overlay.js && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.16.1",
    "tesseract.js": "5.1.1"
  },
  "build": {
    "appId": "io.github.milkmiraclework-alt.tartarus-overlay-optimized",
    "productName": "Tartarus Optimized",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "build/icon.png",
      "!node_modules/koffi/build/koffi/{darwin_arm64,darwin_x64,freebsd_arm64,freebsd_ia32,freebsd_x64,linux_arm64,linux_armhf,linux_ia32,linux_loong64,linux_riscv64d,linux_x64,musl_arm64,musl_x64,openbsd_ia32,openbsd_x64,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Tartarus-Optimized-Setup-${version}-${arch}.${ext}",
      "shortcutName": "Tartarus Optimized",
      "uninstallDisplayName": "Tartarus Optimized"
    },
    "executableName": "Tartarus Optimized",
    "extraResources": [
      {
        "from": "dist/bundled-site",
        "to": "site",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*.node",
      "node_modules/koffi/**/*.dll"
    ],
    "portable": {
      "artifactName": "Tartarus-Optimized-Portable-${version}-${arch}.${ext}"
    }
  }
}
